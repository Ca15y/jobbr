# Create a Supabase project and copy these values from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Use the same 32-byte base64 value across rolling self-hosted deployments.
# Generate one with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Register at https://developer.adzuna.com/ to enable the third job source.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Country feeds to supplement worldwide-first results.
ADZUNA_COUNTRIES=za,gb,us
