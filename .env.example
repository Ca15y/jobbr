# Create a Supabase project and copy these values from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Register at https://developer.adzuna.com/ to enable the third job source.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Country feeds to supplement worldwide-first results.
ADZUNA_COUNTRIES=za,gb,us
